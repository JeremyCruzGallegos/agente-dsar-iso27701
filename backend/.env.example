# Copiar a backend/.env o ejecutar scripts/setup.py (genera claves locales).
APP_ENV=development
SERVICE_API_KEY=
DPO_API_KEY=
AUDIT_HASH_KEY=
DSAR_INTAKE_MODE=direct
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/dsar-request
N8N_WEBHOOK_TOKEN=
N8N_TIMEOUT_SECONDS=10
DSAR_SLA_DAYS=30
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
LLM_CONTEXT_MAX_CHARS=12000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
DATABASE_URL=postgresql+psycopg://dsar:dsar_local@127.0.0.1:5432/dsar_agent
